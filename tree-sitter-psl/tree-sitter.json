{
  "grammars": [
    {
      "name": "psl",
      "camelcase": "Psl",
      "scope": "source.psl",
      "path": ".",
      "file-types": [
        "psl"
      ],
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.1.0",
    "license": "GPL-3.0",
    "description": "PSL (Property Specification Language, IEEE 1850) grammar for tree-sitter",
    "links": {
      "repository": "https://github.com/chrbirks/psl-ts-mode"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true
  }
}
